# --- Clerk (required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/projects
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/projects

# --- Neon Postgres (required) ---
DATABASE_URL=

# --- Python sidecar ---
PYTHON_SIDECAR_URL=http://localhost:8000
PYTHON_SIDECAR_SHARED_SECRET=

# --- Upstash Redis (rate limiting; required for reviewer flow) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vercel Blob (exports only) ---
BLOB_READ_WRITE_TOKEN=

# --- Reviewer escape hatch (optional) ---
REVIEWER_PASSWORD=
REVIEWER_ANTHROPIC_KEY=
REVIEWER_SPEND_CAP_USD=2
REVIEWER_SESSION_TTL_DAYS=7

# --- Sentry (optional) ---
SENTRY_DSN=
