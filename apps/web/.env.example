# --- Clerk (required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/projects
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/projects

# --- Neon Postgres (required) ---
DATABASE_URL=

# --- Upstash Redis (required for reviewer flow + rate limiting) ---
# Set EITHER pair. Vercel's Marketplace Upstash integration injects the KV_*
# names automatically; the legacy direct-Upstash names also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Vercel Blob (exports only) ---
BLOB_READ_WRITE_TOKEN=

# --- Reviewer escape hatch (optional, but enables /reviewer flow) ---
# Required to enable: a password + at least one provider key.
REVIEWER_PASSWORD=
REVIEWER_ANTHROPIC_KEY=
REVIEWER_OPENAI_KEY=
REVIEWER_GOOGLE_KEY=
# Per-session spend cap (USD). Reviewers can't spend more than this in a single session.
REVIEWER_SPEND_CAP_USD=2
# Deployment-wide daily budget across ALL reviewer sessions. Refreshes at UTC
# midnight. Acts as a soft global cap so re-activating doesn't bypass spend
# protection.
REVIEWER_DAILY_BUDGET_USD=20
# How long a reviewer session cookie + Redis-backed state is valid.
REVIEWER_SESSION_TTL_DAYS=7

# --- Sentry (optional) ---
SENTRY_DSN=
